# Copy this file to .env in the repository root before running docker compose.
# The current compose setup expects PostgreSQL to run on the host machine or outside compose.

POSTGRES_PASSWORD=postgres
Auth__SigningKey=super-secret-key-super-secret-key-123456
Cors__AllowedOrigins__0=http://localhost:5173

SupportAi__BaseUrl=https://ollama.com
SupportAi__Model=gpt-oss:120b
SupportAi__ApiKey=
SupportAi__TimeoutSeconds=90
