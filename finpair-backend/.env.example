ASPNETCORE_ENVIRONMENT=Development

# Used by docker-compose.yml when it is copied to .env in the repository root.
# The compose setup expects PostgreSQL to run on the host machine or outside compose.
ConnectionStrings__Postgres=Host=host.docker.internal;Port=5432;Database=finpair;Username=postgres;Password=root;GssEncryptionMode=Disable

# Used by migration tools when run directly.
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=finpair;Username=postgres;Password=root;GssEncryptionMode=Disable

Auth__Issuer=FinPair.AuthService
Auth__Audience=FinPair.Api
Auth__SigningKey=replace-with-at-least-32-characters
Auth__AccessTokenLifetimeMinutes=15
Auth__RefreshTokenLifetimeDays=30
Auth__RefreshCookieName=finpair.refresh_token
Auth__RefreshCookiePath=/api/v1/auth
Auth__RefreshCookieSameSite=Lax
Auth__RefreshCookieSecure=false
