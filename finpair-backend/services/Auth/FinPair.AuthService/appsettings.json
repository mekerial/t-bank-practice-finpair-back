{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=finpair;Username=postgres;Password=root;GssEncryptionMode=Disable"
  },
  "Auth": {
    "Issuer": "FinPair.AuthService",
    "Audience": "FinPair.Api",
    "SigningKey": "finpair-local-development-signing-key-please-change",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "RefreshCookieName": "finpair.refresh_token",
    "RefreshCookiePath": "/api/v1/auth",
    "RefreshCookieSameSite": "Lax",
    "RefreshCookieSecure": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
